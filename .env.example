# 本地开发默认使用 Ollama。生产 vLLM 配置见 .env.vllm.example。
CHAT_BACKEND=ollama
CHAT_BASE_URL=http://127.0.0.1:11434
CHAT_API_KEY=
CHAT_MODEL=qwen3.5:9b
CHAT_ENABLE_THINKING=false
EMBEDDING_BACKEND=ollama
EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3-embedding:0.6b
INDEX_PATH=data/index.json
RAG_TOP_K=4
RAG_MIN_SCORE=0.45
RAG_NUM_CTX=8192
RAG_TEMPERATURE=0
RAG_SEED=42
RAG_MAX_TOKENS=600
MODEL_TIMEOUT=600

# 旧版 .env 的 OLLAMA_BASE_URL 和 OLLAMA_TIMEOUT 仍兼容，但新配置不要再依赖它们。
