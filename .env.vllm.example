# 标准 vLLM（NVIDIA）和 vLLM-Ascend（Atlas）共用这一套应用配置。
# 两个模型服务只监听本机；API Key 请在部署时替换为随机密钥，不要提交 Git。
CHAT_BACKEND=openai
CHAT_BASE_URL=http://127.0.0.1:8100/v1
CHAT_API_KEY=replace-with-controlled-secret
CHAT_MODEL=qwen3.5
CHAT_ENABLE_THINKING=false

EMBEDDING_BACKEND=openai
EMBEDDING_BASE_URL=http://127.0.0.1:8101/v1
EMBEDDING_API_KEY=replace-with-controlled-secret
EMBEDDING_MODEL=qwen3-embedding

# vLLM 向量与 Ollama 向量不能混用，使用独立索引并重新构建。
INDEX_PATH=data/index-vllm.json
RAG_TOP_K=4
RAG_MIN_SCORE=0.45
RAG_NUM_CTX=8192
RAG_TEMPERATURE=0
RAG_SEED=42
RAG_MAX_TOKENS=600
MODEL_TIMEOUT=600
