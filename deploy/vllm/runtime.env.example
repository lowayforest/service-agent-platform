# 复制为 deploy/vllm/runtime.env 后填写。runtime.env 不提交 Git。
# 模型路径既可以是本地绝对路径，也可以是受支持的远程模型 ID。
CHAT_MODEL_PATH=/home/shuncs/models/Qwen3.5-9B
EMBEDDING_MODEL_PATH=/home/shuncs/models/Qwen3-Embedding-0.6B

# 请替换为两个不同的随机密钥；不要使用示例值。
CHAT_API_KEY=replace-with-random-chat-secret
EMBEDDING_API_KEY=replace-with-random-embedding-secret

CHAT_SERVED_MODEL_NAME=qwen3.5
EMBEDDING_SERVED_MODEL_NAME=qwen3-embedding

VLLM_CHAT_GPU=0
VLLM_EMBEDDING_GPU=1
VLLM_CHAT_PORT=8100
VLLM_EMBEDDING_PORT=8101
VLLM_MAX_MODEL_LEN=8192
VLLM_CHAT_GPU_MEMORY_UTILIZATION=0.80
VLLM_EMBEDDING_GPU_MEMORY_UTILIZATION=0.50
